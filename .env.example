# Copy to .env and fill in. Nothing here is read until the adapter that needs it runs.

# Materials Project (free key: https://next-gen.materialsproject.org/api)
MP_API_KEY=

# OpenAlex (free key, required for most requests since Feb 2026: https://openalex.org/settings/api)
OPENALEX_API_KEY=
# Contact address OpenAlex asks for; goes in the mailto parameter, never in cassettes
OPENALEX_MAILTO=

# Anthropic (Phase 3)
ANTHROPIC_API_KEY=

# Postgres (matches compose.yaml; host port 5433 because 5432 is often taken locally).
# Three roles, see src/materials_triage/provenance/roles.sql. Dev passwords equal role names.
DATABASE_URL=postgresql+psycopg://triage_app:triage_app@localhost:5433/triage
DATABASE_URL_MIGRATE=postgresql+psycopg://triage_migrate:triage_migrate@localhost:5433/triage
DATABASE_URL_MAINT=postgresql+psycopg://triage_maint:triage_maint@localhost:5433/triage

# Where large upstream snapshots (JARVIS dft_3d, matbench_expt_gap) are cached. Gitignored.
DATA_CACHE_DIR=.data-cache
