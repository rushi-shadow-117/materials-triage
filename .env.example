# Copy to .env and fill in. Nothing here is read until the adapter that needs it runs.

# Materials Project (free key: https://next-gen.materialsproject.org/api)
MP_API_KEY=

# OpenAlex (free key, required for most requests since Feb 2026: https://openalex.org/settings/api)
OPENALEX_API_KEY=
# Contact address OpenAlex asks for; goes in the mailto parameter, never in cassettes
OPENALEX_MAILTO=

# LLM (Track B). Provider: anthropic | bedrock | openai_compatible | none.
# The model id is the exact string the provider serves and is recorded in every bundle.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# openai_compatible only: base URL ending in /v1 and an optional bearer token
LLM_BASE_URL=
LLM_API_KEY=
# bedrock only
AWS_REGION=

# Postgres (matches compose.yaml; host port 5433 because 5432 is often taken locally).
# Three roles, see src/materials_triage/provenance/roles.sql. Dev passwords equal role names.
DATABASE_URL=postgresql+psycopg://triage_app:triage_app@localhost:5433/triage
DATABASE_URL_MIGRATE=postgresql+psycopg://triage_migrate:triage_migrate@localhost:5433/triage
DATABASE_URL_MAINT=postgresql+psycopg://triage_maint:triage_maint@localhost:5433/triage

# Where large upstream snapshots (JARVIS dft_3d, matbench_expt_gap) are cached. Gitignored.
DATA_CACHE_DIR=.data-cache

# Fetch mode for the Postgres-backed store: live (store first, network on a miss or an expired
# entry), replay (store only, no network), refresh (always network). Default live.
FETCH_MODE=live

# Eval judge: fake (default, CI) or anthropic (uses ANTHROPIC_API_KEY).
EVAL_LLM=fake

# Evidence classification: live (default) calls the model for abstracts not in the classifier
# cache; cache_only never calls it and marks misses unclassified. Demo configuration:
# LLM_PROVIDER=anthropic, LLM_MODEL=claude-sonnet-5-5, CLASSIFY_MODE=cache_only (one parse
# call per Describe request; Rank my list makes none).
CLASSIFY_MODE=live

# API auth. none: every request carries DEV_ROLE (local only). static: bearer tokens from
# STATIC_TOKENS="token:role,token:role"; refused when SITE_MODE=true unless
# ALLOW_STATIC_TOKENS=true. oidc: JWTs from OIDC_ISSUER for OIDC_AUDIENCE, roles read from
# OIDC_ROLES_CLAIM (Keycloak realm roles by default).
AUTH_MODE=none
DEV_ROLE=scientist
STATIC_TOKENS=
SITE_MODE=false
ALLOW_STATIC_TOKENS=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_ROLES_CLAIM=realm_access.roles
